<?xml version="1.0" encoding="utf-8"?>
<!-- Archivo: data/product_data.xml -->
<odoo>
    <!-- Producto genérico para líneas de WooCommerce no encontradas -->
    <record id="product_woo_generic_template" model="product.template">
        <field name="name">Producto WooCommerce</field>
        <field name="detailed_type">product</field>
        <field name="sale_ok">True</field>
        <field name="purchase_ok">False</field>
        <field name="default_code">WOO-GENERIC</field>
        <field name="categ_id" ref="product.product_category_all"/>
        <field name="description">Producto genérico para líneas de pedido de WooCommerce sin correspondencia en Odoo.</field>
    </record>
</odoo>
